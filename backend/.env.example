# Server
PORT=4000
CLIENT_URL=http://localhost:5173
COOKIE_SECRET=change_this_secret
JWT_SECRET=change_this_jwt_secret

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/reachinbox?schema=public"

# Redis (used by BullMQ + rate-limit counters)
REDIS_HOST=localhost
REDIS_PORT=6379

# Google OAuth (create credentials at https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# Ethereal Email (fake SMTP) - https://ethereal.email/create
# Create one or more test accounts; each becomes a "Sender" row.
ETHEREAL_SMTP_HOST=smtp.ethereal.email
ETHEREAL_SMTP_PORT=587
ETHEREAL_USER_1=your_ethereal_user_1
ETHEREAL_PASS_1=your_ethereal_pass_1
ETHEREAL_USER_2=your_ethereal_user_2
ETHEREAL_PASS_2=your_ethereal_pass_2

# Scheduler defaults (overridable per-batch from the frontend)
DEFAULT_MIN_DELAY_MS=2000
DEFAULT_MAX_EMAILS_PER_HOUR=200

# Worker
WORKER_CONCURRENCY=5
